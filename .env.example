# S3-compatible bucket used to store the generated dbt docs artifacts
DOCHOST_S3_BUCKET=my-dbt-docs-bucket
DOCHOST_S3_REGION=us-east-1
# Leave unset to use AWS S3; set for MinIO / other S3-compatible endpoints
DOCHOST_S3_ENDPOINT_URL=
DOCHOST_S3_ACCESS_KEY_ID=
DOCHOST_S3_SECRET_ACCESS_KEY=
DOCHOST_S3_PREFIX=docs

# API key required to POST /upload
DOCHOST_UPLOAD_API_KEY=change-me
