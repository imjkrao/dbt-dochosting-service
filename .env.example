# API key required to publish docs (POST /upload, POST /api/v1/.../versions,
# and DELETE of a version).
DOCHOST_UPLOAD_API_KEY=change-me

# Which storage backend to use: local | s3 | azure
DOCHOST_STORAGE_BACKEND=local

# --- serving and limits ---
# Largest single artifact accepted, in bytes (default 100 MiB). This bounds how
# much one upload can ask the process to hold in memory.
DOCHOST_MAX_UPLOAD_BYTES=104857600
# Redirect large artifacts (manifest.json, catalog.json) to a time-limited
# storage URL instead of proxying the bytes. Requires a CORS rule on the
# bucket/container — see the README before enabling.
DOCHOST_PRESIGNED_REDIRECTS=false
DOCHOST_PRESIGNED_EXPIRY_SECONDS=900

# --- logging ---
DOCHOST_LOG_LEVEL=INFO
DOCHOST_LOG_FORMAT=json   # json | text

# --- local backend ---
# Directory the docs artifacts are written to (only used when
# DOCHOST_STORAGE_BACKEND=local). Mount a volume here in Docker if you
# want uploads to survive container restarts.
DOCHOST_LOCAL_STORAGE_PATH=./data/docs

# --- s3 backend (only used when DOCHOST_STORAGE_BACKEND=s3) ---
DOCHOST_S3_BUCKET=my-dbt-docs-bucket
DOCHOST_S3_REGION=us-east-1
# Leave unset to use AWS S3; set for MinIO / other S3-compatible endpoints
DOCHOST_S3_ENDPOINT_URL=
DOCHOST_S3_ACCESS_KEY_ID=
DOCHOST_S3_SECRET_ACCESS_KEY=
DOCHOST_S3_PREFIX=docs

# --- azure backend (only used when DOCHOST_STORAGE_BACKEND=azure) ---
DOCHOST_AZURE_CONTAINER=dbt-docs
# Either set a connection string...
DOCHOST_AZURE_CONNECTION_STRING=
# ...or an account URL + key
DOCHOST_AZURE_ACCOUNT_URL=
DOCHOST_AZURE_ACCOUNT_KEY=
DOCHOST_AZURE_PREFIX=docs
